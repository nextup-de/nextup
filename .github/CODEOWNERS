/apps/app/src/config/roles.ts             @selluxhenner
/apps/app/src/features/auth/              @selluxhenner
/apps/app/src/features/cases/reducer.ts   @selluxhenner
/apps/app/prisma/schema/                 @selluxhenner
/.github/                                 @selluxhenner
