    "schemas": {
      "ApiV1Case": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CaseRef"
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "ApiV1CaseCreate": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "kind": {
            "type": "string",
            "enum": [
              "problem",
              "idea"
            ]
          },
          "raisedByUserId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "routeHint": {
            "type": [
              "string",
              "null"
            ]
          },
          "externalId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "title",
          "body",
          "kind",
          "raisedByUserId",
          "routeHint",
          "externalId"
        ],
        "additionalProperties": false
      },
      "ApiV1CaseCreated": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CaseRef"
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "ApiV1CaseList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CaseRef"
            }
          },
          "page": {
            "$ref": "#/components/schemas/ApiV1PageInfo"
          }
        },
        "required": [
          "data",
          "page"
        ],
        "additionalProperties": false
      },
      "ApiV1DecisionList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Decision"
            }
          },
          "page": {
            "$ref": "#/components/schemas/ApiV1PageInfo"
          }
        },
        "required": [
          "data",
          "page"
        ],
        "additionalProperties": false
      },
      "ApiV1Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "bad_request",
                  "unauthorized",
                  "forbidden",
                  "not_found",
                  "conflict",
                  "rate_limited",
                  "internal"
                ]
              },
              "message": {
                "type": "string",
                "maxLength": 500
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "ApiV1Org": {
        "type": "object",
