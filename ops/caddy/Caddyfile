# Production. One wildcard certificate for the whole tenant space, via DNS-01 at hosttech.
# Requires HOSTTECH_API_TOKEN and these two DNS records pointing at the box:
#     A   nextup.serviweb.ch     -> <VPS IP>
#     A   *.nextup.serviweb.ch   -> <VPS IP>
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN}, *.{$APP_DOMAIN} {
	tls {
		dns hosttech {$HOSTTECH_API_TOKEN}
	}

	# Reserved hosts. These are NOT tenants - src/features/auth/request.ts keeps the same list,
	# so a company can never be created with one of these slugs.
	@n8n host n8n.{$APP_DOMAIN}
	@mail host mail.{$APP_DOMAIN}
	# Both are ops tools, not the product: nobody reaches them without the ops login. mailpit has
	# no login of its own, and n8n makes whoever opens it first its owner. An unset OPS_USER or
	# OPS_PASSWORD_HASH answers 401 to everyone - closed, never open.
	#
	# One exception, off until N8N_WEBHOOKS=public: n8n's production webhooks skip the login,
	# because Jira can't sign in. Only POST /webhook/<letters, digits, - and _> on n8n.<domain>,
	# checked on the raw request line: no dots, %-escapes or double slashes. The editor, /rest and
	# /webhook-test/ keep the login. The Header Auth on each Webhook node guards the webhook itself.
	# Same rule as stack/caddy/Caddyfile; self-check: node --test stack/caddy/webhook.test.mjs
	@n8nWebhook {
		host n8n.{$APP_DOMAIN}
		method POST
		expression `{env.N8N_WEBHOOKS} == "public" && {http.request.orig_uri}.matches("^/webhook(/[A-Za-z0-9_-]+)+/?([?][^#[:space:]]*)?$")`
	}
	handle @n8nWebhook {
		# The editor's host: its cookies stay out, and nothing a webhook answers may run there.
		reverse_proxy n8n:5678 {
			header_up -Cookie
			header_down -Set-Cookie
			header_down Content-Security-Policy "sandbox; default-src 'none'"
			header_down X-Content-Type-Options nosniff
		}
	}
	handle @n8n {
		basic_auth {
			{$OPS_USER} {$OPS_PASSWORD_HASH}
		}
		reverse_proxy n8n:5678
	}
	handle @mail {
		basic_auth {
			{$OPS_USER} {$OPS_PASSWORD_HASH}
		}
		reverse_proxy mailpit:8025
	}

	# Everything else - the apex, www, admin and every company subdomain - is the app. It reads
	# the Host header itself and rewrites <slug>.<domain> to /<slug>/... in src/proxy.ts.
	handle {
		reverse_proxy app:3000
	}

	encode zstd gzip
}
