      "typeVersion": 4.2,
      "position": [
        -160,
        0
      ],
      "credentials": {},
      "notes": "Credential <slug>-nextup (Header Auth: Authorization = Bearer <token>). Read-only: writes nothing to the company."
    },
    {
      "parameters": {
        "jsCode": "// 200 = n8n reaches the app and the token is accepted. The error text says which part failed.\nconst r = $input.first().json;\nreturn [{ json: {\n  result: r.statusCode === 200 ? 'PASS' : 'FAIL',\n  status: r.statusCode,\n  events: r.body?.count,\n  cursor: r.body?.cursor,\n  error: r.body?.error,\n} }];"
      },
