# Copy to .env.local - never commit .env.local (see .gitignore).
# DATABASE_URL is live as of the Prisma schema; the rest still arrive with sessions and tenancy.
#
# Prisma 7 note: the connection string is read by prisma7.config.ts, not by schema.prisma
# (`url = env(...)` in a datasource is a validation error since v7). The CLI loads .env.local
# itself, so `npx prisma migrate dev` works without exporting anything.
#
# Leave DATABASE_URL unset to run against the built-in demo tenant with no database at all -
# `npm run dev`, `npm test` and `npm run build` all work that way, which is how CI runs. A set
# DATABASE_URL that nothing answers at (no Docker) falls back to the same demo, with a warning.
# 127.0.0.1, not localhost: Node resolves localhost to ::1 first and Docker Desktop publishes
# the port on IPv4 only, so a `localhost` URL fails with "Can't reach database server at ::1".
DATABASE_URL="postgresql://nextup:nextup@127.0.0.1:5432/nextup"
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"
# How a company is addressed. Subdomain mode is what the compose stack serves.
#   path      -> nextup.serviweb.ch/acme/...
#   subdomain -> acme.nextup.serviweb.ch/...
TENANT_MODE="path"
#   single    -> one company per deployment, served at the root of APP_ORIGIN (one stack per
#                company, docs/PLATFORM_PLAN.md). Needs COMPANY_SLUG and APP_ORIGIN.
# COMPANY_SLUG="acme"
# APP_ORIGIN="https://acme.sellux.ch"      # wins over APP_DOMAIN + PUBLIC_SCHEME when set
# LANDING_URL="https://sellux.ch"          # the public site, linked from /admin in single mode

# ── Self-hosting (ops/, compose.yml) ─────────────────────────────────────────
# Copy this file to .env on the box (compose reads .env; Next reads .env.local).
# Laptop: APP_DOMAIN=localhost, CADDYFILE=Caddyfile.dev, PUBLIC_SCHEME=http, COOKIE_SECURE=false
# VPS:    APP_DOMAIN=nextup.serviweb.ch, CADDYFILE=Caddyfile, PUBLIC_SCHEME=https, COOKIE_SECURE=true
APP_DOMAIN="localhost"
CADDYFILE="Caddyfile.dev"
PUBLIC_SCHEME="http"
COOKIE_SECURE="false"

# Postgres password for the compose stack. Generate one: openssl rand -base64 24
POSTGRES_PASSWORD="change-me"

# Opens /admin, where companies are created. Generate one: openssl rand -base64 24
ADMIN_ACCESS_CODE="change-me"

# Demo boxes only: puts a "Demo code" button in the /admin login field that fills
# ADMIN_ACCESS_CODE in one click. It ships the code to the browser in the page source -
# leave it unset anywhere the admin area is worth protecting.
ADMIN_DEMO_FILL="false"

# The public site (nextup-landing) forwards its /contact form to POST /api/pilot-requests with
# this as a bearer token; set the same value there. Unset = the endpoint answers 404.
# Generate one: openssl rand -hex 32
PILOT_INTAKE_TOKEN=

# Bug reports (the bug icon) are forwarded to our developer tool, and its replies fetched back,
# once a minute - outbound only (src/server/tickets-sync.ts). The token names this stack; it is
# issued in admin.sellux.ch -> Stacks. Leave both empty and reports stay in this deployment.
OPS_URL=
OPS_TOKEN=

# Demo boxes only: a "View the demo as..." list on the login page of companies in stage "demo"
# (made-up people) - one click logs in as that person, no code. Never shown for a sandbox,
# pilot or live company, whatever this says. Leave it unset anywhere real people log in.
LOGIN_DEMO_FILL="false"

# "Continue with Microsoft" (Entra ID, OpenID Connect). One app registration for the whole
# server: multi-tenant ("accounts in any organizational directory"), a web platform with every
# company's redirect URI (/admin -> Companies -> People & sign-in shows each one), and a client
# secret. Each company then opts in with its tenant ID in /admin; its IT admin consents once.
# Leave both empty and the button is never shown - personal login codes still work.
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""

# Only for the production Caddyfile of the old multi-tenant stack (wildcard cert via DNS-01 at
# hosttech). Company stacks (stack/) don't use these: their TLS is Caddy's own or nginx+certbot.
ACME_EMAIL=""
HOSTTECH_API_TOKEN=""

# Production Caddyfiles only: the login in front of n8n.<domain> and mail.<domain>. Until both are set,
# both hosts answer 401 to everyone. Make the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext '<a long random password>'
# and keep it in SINGLE quotes - the bcrypt hash is full of `$`, which compose would expand.
OPS_USER=""
OPS_PASSWORD_HASH=''

# Outgoing mail: the email a route owner gets when a case is raised, and replies to pilot requests
# from /admin. Unset = a raise notifies nobody, and replies fall back to "open in your mail app".
# Dev: mailpit's SMTP port, published on the loopback by compose.yml; in the stack it is mailpit:1025.
# Real relay: smtp://user:pass@smtp.example.com:587 (or smtps://...:465).
SMTP_URL="smtp://127.0.0.1:1025"
MAIL_FROM="NextUp <hello@nextup.serviweb.ch>"

# The raise-page assistant (docs/ASSISTANT.md). Leave LLM_PROVIDER empty and answers are built from
# lookups over the company knowledge - no model, nothing leaves the server. bedrock = Claude on
# Amazon Bedrock, called in LLM_REGION. An EU geographic inference profile as LLM_MODEL keeps
# processing inside EU regions (not only Frankfurt); check the exact model ID, single-region
# availability and the account's retention in the Bedrock console first. Credentials come from the
# standard AWS chain: these two, an AWS profile, or the instance role. Outside the demo stage a
# company also needs the assistant switched on and its DPA date recorded in /admin -> Knowledge.
LLM_PROVIDER=""
LLM_REGION="eu-central-1"
LLM_MODEL="anthropic.claude-opus-5"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# The brain (services/brain/README.md): a language model proposes the routing row and spots a
# repeat when an idea is published. Empty = the keyword router alone. On a laptop run the brain
# with `uv run uvicorn brain.main:app --port 8000` in services/brain and set its API_KEY to the
# same value. In a stack, stack/install.sh --brain writes both. BRAIN_TIMEOUT_MS: how long a
# publish waits for it before the keyword row is used (default 30000).
BRAIN_URL=""
BRAIN_API_KEY=""
BRAIN_TIMEOUT_MS=""
