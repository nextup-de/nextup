// Area support (docs/adr/0007-areas.md). Models: SupportGrant. Changed only by: ITC. Every migration is its own folder under prisma/migrations.

// NextUp support access (ITC/D8): one code a console admin opens, valid 24 h or until revoked, at
// most one active per company. Only the scrypt hash is stored; the code itself is shown once.
model SupportGrant {
  id        String    @id @default(cuid())
  companyId String
  codeHash  String // salt:hash, features/admin/support-code.ts
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  openedBy  String // who opened it: the console admin's sign-in name
  signins   Json      @default("[]") // ISO times of the last 20 support sign-ins, oldest first

  @@index([companyId])
}
