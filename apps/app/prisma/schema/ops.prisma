// Area ops (docs/adr/0007-areas.md). Models: FeatureFlag, PilotRequest, PilotReply, Ticket, TicketReply, ErrorGroup. Changed only by: GDP. Every migration is its own folder under prisma/migrations.

// ── Feature flags (src/config/flags.ts, src/features/flags) ───────────────────────────────────────
// NextUp's rollout switches for this company, as admin.sellux.ch set them - the stack fetches the
// full list once a minute and keeps it here, so a flag holds while admin is away. A flag with no
// row here gets its stage default from src/config/flags.ts. Not customer settings: those are
// CompanyConfig, and the company never sees these.
model FeatureFlag {
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String // a key of FLAGS in src/config/flags.ts; one deleted since is ignored
  enabled   Boolean
  source    String   @default("admin") // who set it: admin (admin.sellux.ch)
  updatedAt DateTime // when admin set it (admin's clock)

  @@id([companyId, key])
}

// A pilot request from the public /contact form. Not a tenant table: the company named here is
// free text typed by a stranger, not a Company row - it becomes one only when someone in /admin
// decides so. Nothing is ever updated except `handledAt`, which is the one fact worth recording.
model PilotRequest {
  id String @id @default(cuid())

  name     String
  company  String
  email    String
  decision String
  council  String // no | yes | not sure - src/features/pilot/request.ts
  message  String @default("")

  createdAt DateTime  @default(now())
  handledAt DateTime?

  // Ours, never shown to the person who wrote in: what we know, what was agreed on the phone.
  notes   String       @default("")
  replies PilotReply[]

  @@index([createdAt])
}

// One answer sent (or logged as sent) from /admin/requests. Kept so the panel shows the thread,
// not just a "replied" timestamp; goes with its request on delete.
model PilotReply {
  id        String       @id @default(cuid())
  requestId String
  request   PilotRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  to      String
  subject String
  body    String
  via     String // smtp | manual - features/admin/reply.ts
  sentAt  DateTime @default(now())

  @@index([requestId, sentAt])
}

// ── Bug reports (docs/plans/2026-09-27_platform.md, "Tickets") ────────────────────────────────────────────────
// Filed from the bug icon. The full ticket, screenshot included, stays in this stack; a copy goes to
// admin.sellux.ch (packages/contracts TicketIntake) and replies come back as TicketReply rows.

model Ticket {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number    Int // per company, shown as NU-<number>

  // Null when filed from /admin (no person behind it). The person, not a copy of their name: the
  // report shows up under "My reports" for whoever filed it.
  reporterId   String?
  reporter     User?   @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  reporterRole String // manager | leader | member | admin

  kind        String // bug | idea | question
  impact      String // blocks | annoying | cosmetic
  description String
  expected    String @default("")
  context     Json // TicketContext: path, browser, viewport, console errors - no names

  screenshot     Bytes?
  screenshotMime String?

  status String @default("new") // new | in_progress | fixed | closed - mirrors admin.sellux.ch
  // Who of the NextUp team is on it, as admin.sellux.ch says (GET /api/ticket-state). "" = nobody yet.
  assignee String @default("")
  // Demo stacks: who of the team (or Marc) opened it, picked in the report dialog. "" = somebody unknown.
  openedBy String @default("")

  // Forwarding to admin.sellux.ch. Null forwardedAt = still to send; the sync retries.
  forwardedAt  DateTime?
  forwardError String?

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  replies   TicketReply[]

  @@unique([companyId, number])
  @@index([companyId, reporterId, createdAt])
  @@index([companyId, forwardedAt])
}

// A developer's reply meant for the reporter, fetched from admin.sellux.ch. Never edited.
model TicketReply {
  id         String  @id @default(cuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ticketId   String
  ticket     Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  opsReplyId String  @unique // admin.sellux.ch's id - a re-fetched reply is skipped, not doubled

  body      String
  status    String // the ticket's status after this reply
  createdAt DateTime // when the developer wrote it (admin.sellux.ch's clock)
  receivedAt DateTime @default(now())
  emailedAt  DateTime? // the reporter was told by mail

  @@index([companyId, createdAt])
  @@index([ticketId, createdAt])
}

// ── Errors (features/errors; docs/plans/2026-10-05_admin-vs-ses.md, PR 3 "auto tickets") ──────────
// One row per kind of error this stack ran into by itself - a page, action or route that threw, or a
// script error in a browser - with how often and when. Kept per stack, not per company: the row
// holds no company data by construction (scrubbed message, route pattern, top frame), so it is not
// a tenant table. `pending` = counted since the last send to admin.sellux.ch, which turns each row
// into one "auto" ticket. Rows not seen for 30 days are pruned (src/lib/db/errors.ts).
model ErrorGroup {
  id          String   @id @default(cuid())
  fingerprint String   @unique // features/errors fingerprint(): source, name, message pattern, route
  source      String // server | client
  name        String // TypeError, PrismaClientKnownRequestError, ...
  message     String // scrubbed, at most 300 characters
  frame       String   @default("") // the last top frame from our code - shown, never compared
  route       String // /[company]/cases/[id]
  count       Int      @default(0) // every occurrence since firstSeenAt
  firstSeenAt DateTime
  lastSeenAt  DateTime
  appCommit   String? // NEXTUP_COMMIT of the build that saw it last

  pending      Boolean   @default(true)
  forwardedAt  DateTime?
  forwardError String?

  @@index([pending, lastSeenAt])
}
