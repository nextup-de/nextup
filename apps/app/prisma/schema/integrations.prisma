// Area integrations (docs/adr/0007-areas.md). Models: CompanyConfig, Connection, Integration, Document, OutboxMessage, WebhookSubscription, NotifyPreference, NotifyCursor, TeamsConversation, AiCall. Changed only by: CON, NTF, TMS, AIB. Every migration is its own folder under prisma/migrations.

// Which integrations are on for this company. docs/INTEGRATIONS.md: flipped only by an event, so
// the change is a fact with an actor, not a silent edit.
model CompanyConfig {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  aiRouting     Boolean @default(false)
  n8n           Boolean @default(false)
  notifications Boolean @default(false)
  demoData      Boolean @default(true)

  // The raise-page assistant (docs/ASSISTANT.md). Off until an admin turns it on, and outside the
  // demo stage it also needs the date the data-processing agreement was signed - fail closed.
  assistant             Boolean   @default(false)
  // Highest information class the assistant may read: public | internal | confidential.
  // strictly_confidential is never allowed (features/assist/classify.ts ceilingOf).
  classificationCeiling String    @default("internal")
  // Assistant turns older than this many days are deleted (purgeAssistTurns).
  retentionDays         Int       @default(90)
  dpaSignedAt           DateTime?
  // Company patterns masked before anything reaches the model (regex source), e.g. prototype codes.
  redactPatterns        String[]

  // The idea studio (docs/IDEAS.md): the benchmark score an idea needs before it can be published.
  publishThreshold Int @default(70)

  // After the routing (docs/plans/2026-10-15_idea-to-project.md, src/features/loop/rules.ts): how
  // often a discussion checks in, when a project is measured, and the company's reward rule.
  discussEveryDays    Int     @default(3)
  discussMaxRounds    Int     @default(3)
  fastLaneEur         Int     @default(5000)
  measureDays         Int[]   @default([30, 90])
  measureTolerancePct Int     @default(2)
  // none | thanks | fixed | share
  rewardRule          String  @default("thanks")
  rewardAmountEur     Int?
  rewardSharePct      Int?
  rewardCapEur        Int?

  // Live Microsoft 365 search (docs/plans/2026-10-22_sso-and-data-access.md, phase 2): people may
  // connect their own Microsoft 365 account. Off until the company's admin turns it on.
  m365Search Boolean @default(false)

  defaultLocale String? // de | en (src/i18n). Null: English.
}

// A person's own connection to a source NextUp reads on their behalf - today only Microsoft 365
// (docs/plans/2026-10-22_sso-and-data-access.md, phase 2). NextUp reads as that person, so the
// source decides what they may see; nothing is copied. Disconnecting deletes the row.
model Connection {
  id        String @id @default(cuid())
  companyId String
  userId    String

  provider String // "m365"
  scopes   String[] // as the provider granted them, e.g. ["Files.Read.All", "offline_access"]

  // Sealed with CONNECTOR_VAULT_KEY (features/connectors/vault.ts), bound to company and person.
  // Never logged, never sent to a browser.
  refreshTokenSealed String

  lastUsedAt DateTime?
  lastError  String? // why the provider refused the last refresh; the person has to connect again
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, provider])
  @@index([companyId])
}

// A company's connection to a tool that NextUp syncs with from inside the app - today only Jira
// (docs/plans/2026-10-29_jira-in-app.md). One row per company and system; the secrets are sealed
// (features/connectors/vault.ts, context integration:<companyId>:<system>) and never come back out.
// The shapes of `settings` and `account` are per system: features/integrations/jira/types.ts.
model Integration {
  id        String @id @default(cuid())
  companyId String
  system    String // "jira"

  // Switched on by an admin. Turning it on sets enabledAt; projects that decided "yes" before that
  // are not synced on their own (only through a human project.sync).
  on        Boolean   @default(false)
  enabledAt DateTime?

  settings Json // JiraSettings for "jira": site, project key, issue types, toggles
  // The API token and the webhook secret, sealed. Never logged, never sent to a browser.
  secretSealed        String?
  webhookSecretSealed String?
  // What the tool says the integration account is ({ id, name }), to tell its own changes from a human's.
  account             Json?

  // The sync cursors: the last event sequence pushed out, and when the tool was last read.
  pushedSeq Int       @default(0)
  pulledAt  DateTime?
  // One runner per company: a round may start only after this time has passed.
  leaseUntil DateTime?
  lastRunAt  DateTime?
  lastOkAt   DateTime?
  lastError  String? // why the last round failed; empty after a good one

  updatedBy String? // the admin who last saved it (a name, not a user id)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, system])
  @@index([on, system])
}

// ── Raise-page assistant (docs/ASSISTANT.md) ─────────────────────────────────────────────────────

// A document the assistant may search: an ERP extract, a process description, a policy. Arrives
// from n8n (POST /api/<company>/knowledge/documents) or an admin. `classification` is the TISAX
// class; anything above the company's ceiling is stored but never searched.
model Document {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  source         String // erp | upload | n8n
  externalId     String // the source system's id - upserts key on (companyId, source, externalId)
  title          String
  body           String
  classification String                   @default("confidential") // unlabelled = unreadable until checked
  // Full-text index, generated by Postgres ('simple' config: German and English alike).
  search         Unsupported("tsvector")?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([companyId, source, externalId])
  @@index([companyId])
}

// One message a planner decided to send (docs/adr/0004-webhook-and-outbox.md). (companyId, key) is the
// idempotency key: planning the same fact twice writes one row. The delivery claims due rows, sends
// them through the channel and records the outcome here.
model OutboxMessage {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  channel         String // mail | webhook | any name a later registerChannel adds
  key             String
  recipientUserId String?
  address         String? // mail address or webhook subscription id
  template        String
  locale          String
  subject         String
  text            String
  link            String?
  data            Json    @default("{}")

  status    String    @default("pending") // pending | sent | failed | skipped
  attempt   Int       @default(0)
  nextAt    DateTime  @default(now())
  lastError String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([companyId, key])
  @@index([status, nextAt])
}

// Where a company's public events are posted. The secrets are sealed (features/connectors/vault.ts,
// context "webhook:<companyId>"); several at once so a secret can be rotated without a gap.
model WebhookSubscription {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  url     String
  secrets String[]
  events  String[] // PublicEventType values
  on      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([companyId])
}

// A person's choice to get or not get a template (or "*" for all) by mail.
model NotifyPreference {
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  template  String
  on        Boolean

  @@id([companyId, userId, template])
}

// How far the notification planner has read a company's event log, and the lease that keeps one runner per company.
model NotifyCursor {
  companyId  String    @id
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seq        Int       @default(0)
  leaseUntil DateTime?
  lastRunAt  DateTime?
  lastError  String?
}

// A person's one-to-one chat with the Teams bot (TMS D5). Saved when they first talk to the bot;
// cards are sent into conversationId at serviceUrl. One row per company and person.
model TeamsConversation {
  id             String   @id @default(cuid())
  companyId      String
  userId         String
  aadObjectId    String
  tenantId       String
  conversationId String
  serviceUrl     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
}

// One call of the brain to the company's model (plan AIB D9): what it cost, never what was said. No
// user id, no case id, no text (PILOT/HD5), so it is a company's table and not in a person's export.
model AiCall {
  id        String   @id @default(cuid())
  companyId String
  purpose   String // routing | coach | plan | checkin
  model     String
  tokensIn  Int
  tokensOut Int
  latencyMs Int
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}
