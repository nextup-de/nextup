// Area auth (docs/adr/0007-areas.md). Models: User, ApiToken. Changed only by: DIR. Every migration is its own folder under prisma/migrations.

// A person who can sign in. `role` is a plain String, not an enum, because the three roles are
// data in src/config/roles.ts (Kevin's file) and an enum here would be a second source of truth.
model User {
  id        String @id @default(cuid())
  companyId String

  name String
  // Display text only: people are matched by id, never by this name (phase IDN).

  email String
  role  String // manager | leader | member - see src/config/roles.ts
  dept  String @default("")
  line  String @default("") // "Team lead · Production, 4-series" - persona.who.line
  ini   String @default("")

  handle String? // anonymous handle for members, e.g. "Anonymous #4471"

  // Personal login code: sha256 of it (src/features/auth/login-code.ts). Unique across ALL
  // companies because the login finds the person from the code alone. Null = no code issued.
  loginCodeHash String?   @unique
  loginCodeAt   DateTime? // when the current code was issued - shown in /admin, never the code

  // Microsoft's object id for this person, bound on their first Microsoft sign-in (matched by
  // email then). After that the account is matched by this, which Microsoft never reassigns.
  entraOid String?

  locale String? // de | en (src/i18n). Null: the company's defaultLocale, then English.

  // False = deactivated (left the company, or the directory says so). Kept, not deleted, so the
  // history still names them; the settings guard and sign-in refuse an inactive user.
  active Boolean @default(true)

  // Second factor (phase ADM, features/auth/totp.ts). The TOTP secret is sealed with the connector
  // vault; it counts only once totpEnabledAt is set (the person confirmed one code). isStackAdmin
  // lets this person open /admin with their code and a TOTP; an admin sets it in /admin People.
  totpSecretSealed String?
  totpEnabledAt    DateTime?
  isStackAdmin     Boolean   @default(false)

  // Directory sync (phase DIR). employeeId is the personnel number: never shown, never logged, never sent to the AI.
  employeeId        String?
  managerId         String?
  deactivatedAt     DateTime?
  directorySyncedAt DateTime?

  createdAt DateTime @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  events      CaseEvent[]
  assistTurns AssistTurn[]
  ideaDrafts  IdeaDraft[]
  tickets     Ticket[]
  connections Connection[]
  manager     User?        @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports     User[]       @relation("UserManager")

  @@unique([companyId, email])
  @@unique([companyId, entraOid])
  @@unique([companyId, employeeId])
  @@index([companyId, managerId])
  @@index([companyId, name])
}

// A bearer token for one company's integration endpoints. docs/INTEGRATIONS.md: a token for
// company A used against company B is a 403, and that is a test.
model ApiToken {
  id        String @id @default(cuid())
  companyId String

  name   String
  hash   String   @unique // sha256(raw token), hex. The raw token is shown once and never stored.
  scopes String[] // ["events:read", "events:write"]

  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// One row per company: the directory sync's switch, source, cursor and lease (phase DIR).
// `cursor` is the Graph deltaLink or another source's cursor; never shown.
model DirectoryRun {
  companyId String  @id
  on        Boolean @default(false)
  source    String  @default("graph") // graph | successfactors (features/directory)
  cursor    String?

  leaseUntil  DateTime?
  lastRunAt   DateTime?
  lastOkAt    DateTime?
  lastError   String?
  added       Int       @default(0)
  updated     Int       @default(0)
  deactivated Int       @default(0)
  handed      Int       @default(0)

  updatedAt DateTime @updatedAt
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}
