        "message": "<FeedPanel> doesn't accept that prop. Declared props: supporters, comments, line, onPost."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|hint|error|labelRight|children|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: id, label, hint, error, labelRight, children."
