{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/dashboard/**",
              "components/icons/**",
              "components/ideas/**",
              "components/shell/**",
              "components/system/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|tone|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, size, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|lg|xl)$/]",
        "message": "<Avatar> size must be one of 'sm' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|ink)$/]",
        "message": "<Avatar> tone must be one of 'light' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:left|late|hot|review|piloting|approved|dark|onblue)$/]",
        "message": "<Badge> tone must be one of 'left' | 'late' | 'hot' | 'review' | 'piloting' | 'approved' | 'dark' | 'onblue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md)$/]",
        "message": "<Badge> size must be one of 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bars'] > JSXAttribute > JSXIdentifier[name!=/^(?:spark|tone|size|flat|key|ref|className|style|children)$/]",
        "message": "<Bars> doesn't accept that prop. Declared props: spark, tone, size, flat."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bars'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light)$/]",
        "message": "<Bars> tone must be one of 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bars'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Bars> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Btn'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|onClick|fixed|children|key|ref|className|style|children)$/]",
        "message": "<Btn> doesn't accept that prop. Declared props: kind, onClick, fixed, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Btn'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:primary|accent|disabled|muted)$/]",
        "message": "<Btn> kind must be one of 'primary' | 'accent' | 'disabled' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|href|type|onClick|disabled|className|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, href, type, onClick, disabled, className, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|fill|accent)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost' | 'fill' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|text|initials|tone|when|key|ref|className|style|children)$/]",
        "message": "<ChatMessage> doesn't accept that prop. Declared props: role, text, initials, tone, when."
